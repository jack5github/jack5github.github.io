---
interface Props {
	name: string;
	coauthors?: string[];
}
const { name, coauthors } = Astro.props;

const authors: { nameLower: string; colour: string, url: string }[] = [
	// TODO: Use more appealing colour #ff4200 in Jack5 icon
	{ nameLower: 'jack5', colour: '#ff4d00', url: 'https://discord.gg/scRdSXY' },
	{ nameLower: 'zeroman95', colour: '#90afe0', url: 'https://steamcommunity.com/id/DN9328/' },
];
let nameLower: string = name.toLowerCase().replace(' ', '-');
let bgColour: string = 'inherit';
let authorUrl: string = '#';
for (let i = 0; i < authors.length; i++) {
	if (authors[i].nameLower === nameLower) {
		bgColour = authors[i].colour;
		authorUrl = authors[i].url;
		break;
	}
}
let authorStyle: string = `
	background-color: ${bgColour};
	border-radius: 14px;
	margin-top: 20px;
	padding: 10px;
`.replace(/\s+/g, ' ').trim();
---
<hr/>
<div id="author" style={authorStyle} data-pagefind-ignore>
	<div id="author-main" style="align-items: center; display: flex; gap: 8px;">
		<a href={authorUrl} target="_blank">
			<img
				src=`/images/authors/${nameLower}.webp`
				onerror="this.onerror=null;this.src='/images/authors/unknown.webp'"
				alt={name}
				style="border-radius: 6px; max-width: 96px;"
			/>
		</a>
		<p style="margin: 0px;">Written by {name}</p>
	</div>
	<!--
	TODO: Re-add co-authors
	{ coauthors !== undefined && (
		<p>Co-writers:</p>
		<ul>{coauthors.map((coauthor: string) => (
			<li>{coauthor}</li>
		))}</ul>
	) }
	-->
</div>
