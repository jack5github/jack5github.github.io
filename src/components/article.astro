---
import Author from './author.astro';
import Content from './content.astro';
import Html from './html.astro';

interface Props {
	frontmatter: Record<string, any>;
	headings: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings } = Astro.props;
---
<Html title={frontmatter.title} metaImage={frontmatter.hero}>
	{ frontmatter.hero !== undefined && (
		<a href={frontmatter.hero} target="_blank"><div id="hero">
			<div id="hero-image">
				<img
					src={frontmatter.hero}
					alt={frontmatter.title}
					data-pagefind-meta="image[src], image_alt[alt]"
				/>
			</div>
		</div></a>
		<style>
			/* # Hero image styles */
			div#hero {
				/* Centre vertically */
				align-items: center;
				display: flex;
				max-height: 384px;
				overflow: hidden;
			}
			div#hero-image {
				width: 100%;
			}
			div#hero img {
				transition: transform 0.325s ease;
				width: 100%;
			}
			/* TODO: Do not transform hero if on a mobile device */
			div#hero:hover img {
				transform: scale(1.4);
			}
		</style>
		<script>
			/**
			 * Animate hero image on mouse hover. Allows user to zoom into whatever they are hovering over.
			 */
			// TODO: Improve calculation so all parts of hero image are visible on hover
			const hero = document.getElementById('hero');
			const heroImg = document.getElementById('hero-image');
			const img = heroImg!.querySelector('img');
			document.addEventListener('mousemove', (event) => {
				const heroRect = hero!.getBoundingClientRect();
				const mouseX = event.clientX - heroRect.left;
				const mouseY = event.clientY - heroRect.top;
				const heroPctX = Math.max(0, Math.min(mouseX, heroRect.width)) / heroRect.width;
				const heroPctY = Math.max(0, Math.min(mouseY, heroRect.height)) / heroRect.height;
				const heroImgRect = heroImg!.getBoundingClientRect();
				const heroImgX = heroImgRect.width * heroPctX;
  			const heroImgY = heroImgRect.height * heroPctY;
				img!.style["transform-origin"] = `${heroImgX}px ${heroImgY}px`;
			});
		</script>
	) }
	<Content>
		<h1 data-pagefind-meta="title">{frontmatter.title}</h1>
		<!-- TODO: Remove margin of h1 when cutout is present above -->
		{ frontmatter.cutout !== undefined && (
			<a id="cutout" href={frontmatter.cutout} target="_blank">
				<img src={frontmatter.cutout}/>
			</a>
			<style>
				a#cutout {
					float: right;
					margin: 0px 0px 6px 6px;
					max-width: 192px;
					/*
					TODO: Shrink cutout if screen is too small
					@media screen and (max-width: var(--breakpoint-medium)) {
						max-width: 128px;
					}
					*/
				}
			</style>
		) }
		{ frontmatter.link !== undefined && (
			<a id="article-link" href={frontmatter.link.url} data-pagefind-ignore>
				{frontmatter.link.text || frontmatter.link.url} →
			</a>
		) }
		{ headings.length >= 2 && (
			<div id="table-of-contents" data-pagefind-ignore>
				<p style="font-weight: bold; margin-bottom: 0px;">Table of Contents</p>
				<ul
					style="list-style-type: square; margin-top: 0px; padding-inline-start: 25px;">
					{ headings.map((heading) => (
						<li style={`margin-left: ${(heading.depth - 2) * 25}px`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					)) }
				</ul>
			</div>
		)}
		<slot/>
		{ frontmatter.author !== undefined && (
				<Author name={frontmatter.author} coauthors={frontmatter.coauthors}/>
		) }
		<script>
			/**
			 * Once the document has loaded, move the table of contents to just before the first heading after it.
			 */
			document.addEventListener('DOMContentLoaded', () => {
				const tableOfContents = document.getElementById('table-of-contents');
				const firstNonTitle = document.getElementById('content')!.querySelector(
					'h2, h3, h4, h5, h6'
				);
				if (tableOfContents !== null && firstNonTitle !== null) {
					firstNonTitle.insertAdjacentElement('beforebegin', tableOfContents);
				}
			})
		</script>
	</Content>
</Html>
