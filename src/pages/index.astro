---
import Content from "../components/content.astro";
import Html from "../components/html.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const pages = import.meta.glob("./**/*.{astro,md,mdx}");
const urlPaths: string[] = Object.keys(pages);
const safeUrlPaths: string[] = [];
for (let i = 0; i < urlPaths.length; i++) {
	if (urlPaths[i] === "./404.astro") continue;
	safeUrlPaths.push(urlPaths[i].replace("./", "").split(".")[0]);
}
---

<Html title="Home Page">
	<Content indexInSearch={false}>
		<h1 data-pagefind-meta="title">Home Page</h1>
		<p>Congratulations, you have found Jack5's super-scuffed site. Expect a broken page layout and unfinished articles.</p>
		<h2>Search</h2>
		<PagefindConfig />
		<pagefind-searchbox></pagefind-searchbox>
		<h2>Sitemap</h2>
		<ul>
			{
				safeUrlPaths.map((safeUrlPath) => (
					<li>
						<a href={safeUrlPath}>{safeUrlPath}</a>
					</li>
				))
			}
		</ul>
	</Content>
</Html>
